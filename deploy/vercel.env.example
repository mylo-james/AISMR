# Current public deployment: recorded plan, media references and prepared final.
# No generation provider or renderer is contacted in this mode.
ENVIRONMENT=production
API_KEY=replace-with-a-private-random-secret
DATABASE_URL=postgresql://aismr_runtime:replace@your-neon-host/aismr
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
AISMR_ENABLED=true
AISMR_MODE=recorded
AISMR_RECORDED_FINAL_REUSE=true
AISMR_RECORDED_ROOT=data/recorded/teacup
AISMR_RECORDED_BUNDLE_SHA256=f3ad4df1ab32a719e170062d32b2d8135974a98076a67c8fa510d97d528fe44a
AISMR_RECORDED_BUCKET=aismr-recorded
AISMR_ORIGIN=https://aismr.mjames.dev
AISMR_SESSION_SECRET=replace-with-at-least-32-random-characters
AISMR_COOKIE_SECURE=true
AISMR_LIVE_ENABLED=false
AISMR_RENDER_REAL=false
AISMR_PUBLIC_RUNTIME_ENABLED=false
AISMR_VISITOR_RUNS_24H=3
AISMR_IP_RUNS_24H=20
AISMR_ACTIVE_RUNS=10
AISMR_MEDIA_ROOT=/tmp/aismr/media
AISMR_FIXTURE_ROOT=/tmp/aismr/fixtures
LLAMA_STACK_PROVIDER=fake
SORA_PROVIDER=fake
REMOTION_PROVIDER=fake
UPLOAD_POST_PROVIDER=fake
OPENAI_API_KEY=
FAL_API_KEY=
ZERNIO_API_KEY=
UPLOAD_POST_API_KEY=
AWS_EC2_METADATA_DISABLED=true
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=replace-with-bucket-scoped-read-only-key
AWS_SECRET_ACCESS_KEY=replace-with-bucket-scoped-read-only-secret
TRANSCODE_S3_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
TRANSCODE_S3_REGION=auto
