# Renderer-only environment. Store real secrets outside the repository.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
PUBLIC_BASE_URL=http://renderer:3001
REMOTION_JOB_CONCURRENCY=1
REMOTION_FRAME_CONCURRENCY=1
REMOTION_OUTPUT_PUBLIC=false
REMOTION_ALLOW_COMPOSITION_CODE=false
REMOTION_MEDIA_ALLOWED_ORIGINS=https://aismr.mjames.dev
REMOTION_CALLBACK_ALLOWLIST=aismr.mjames.dev
REMOTION_PRESERVE_NARRATION=false
TMPDIR=/app/render-tmp
# Inject REMOTION_API_SECRET and WEBHOOK_SECRET. The latter must equal the
# app/worker REMOTION_WEBHOOK_SECRET. Do not pass OpenAI or Fal keys here.
