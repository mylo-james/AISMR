# Private one-shot migration configuration. Use the separately scoped source
# database migrator, not another project's role. Inject DATABASE_URL as a direct
# postgresql:// URI without sslmode/channel_binding query parameters.
ENVIRONMENT=production
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
AISMR_ENABLED=false
AISMR_LIVE_ENABLED=false
AISMR_ADMISSION_PAUSED=true
PUBLIC_DEMO_ENABLED=false
LLAMA_STACK_PROVIDER=off
SORA_PROVIDER=off
UPLOAD_POST_PROVIDER=off
REMOTION_PROVIDER=off
KB_SKIP_INGEST_ON_START=true
DISABLE_BACKGROUND_WORKFLOWS=true
# Inject a unique API_KEY for production settings validation as well.
