# Copy to the selected host's private configuration, outside the repository.
# This is the paused AISMR backend for Vercel at aismr.mjames.dev.
# Supply secrets through the host's secret store. Never bake them into an image.
ENVIRONMENT=production
AISMR_ENABLED=true
AISMR_MODE=live
AISMR_PUBLIC_RUNTIME_ENABLED=true
AISMR_PRIVATE_TAILNET_ENABLED=false
AISMR_LIVE_ENABLED=false
AISMR_ADMISSION_PAUSED=true
AISMR_ORIGIN=https://aismr.mjames.dev
AISMR_COOKIE_SECURE=true
AISMR_IDEATION_BACKEND=openai
AISMR_PLANNER_VERSION=creative-v2
AISMR_OPENAI_IDEATION_MODEL=gpt-4o-mini
AISMR_CREATIVE_REPAIR_ATTEMPTS=2
AISMR_PLAN_REVISIONS=1
AISMR_ASSET_RETRIES=0
AISMR_ACTIVE_RUNS=1
AISMR_VISITOR_RUNS_24H=1
AISMR_IP_RUNS_24H=1
AISMR_RENDER_REAL=true
AISMR_PRESERVE_RUN_ARTIFACTS=false

# Inject a direct Neon connection for the dedicated AISMR source database as
# DATABASE_URL=postgresql://... . Do not paste sslmode/channel_binding query
# parameters here: the native drivers read PGSSLMODE below. Use a separate
# AISMR library database via postgresql+asyncpg://... . Neither is provisioned.
# DATABASE_URL and AISMR_LIBRARY_DATABASE_URL are secret-store entries.
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
# Both app and worker mount these same persistent media directories.
AISMR_MEDIA_ROOT=/var/lib/aismr/source/media
AISMR_FIXTURE_ROOT=/var/lib/aismr/fixtures
AISMR_LIBRARY_MEDIA_ROOT=/var/lib/aismr/library/media
AISMR_RIGHTS_PROFILE_PATH=/run/aismr/rights-profile.json

# Fill the version, seven per-operation allowances and overall limits after
# reviewing prices and the selected model. Zero amounts keep generation closed.
AISMR_COST_PROFILE_VERSION=
AISMR_COST_INPUT_MODERATION_USD=0
AISMR_COST_IDEATION_USD=0
AISMR_COST_PLAN_MODERATION_USD=0
AISMR_COST_VIDEO_REQUEST_USD=0
AISMR_COST_NARRATION_BATCH_USD=0
AISMR_COST_RENDER_USD=0
AISMR_COST_FINAL_MODERATION_USD=0
AISMR_DAILY_BUDGET_USD=0
AISMR_RUN_RESERVATION_USD=0

USE_LANGGRAPH_ENGINE=true
WORKFLOW_DISPATCHER=db
DISABLE_BACKGROUND_WORKFLOWS=false
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=120
JOB_POLL_INTERVAL_SECONDS=1
KB_SKIP_INGEST_ON_START=true
PUBLIC_DEMO_ENABLED=false
LLAMA_STACK_PROVIDER=off
SORA_PROVIDER=off
UPLOAD_POST_PROVIDER=off
REMOTION_PROVIDER=real
USE_FAKE_PROVIDERS=false
REMOTION_SERVICE_URL=http://renderer:3001
WEBHOOK_BASE_URL=https://aismr.mjames.dev

# Required secret-store entries: API_KEY, AISMR_SESSION_SECRET,
# REMOTION_API_SECRET, REMOTION_WEBHOOK_SECRET.
# Provider entries when available: OPENAI_API_KEY, FAL_API_KEY.
# Renderer configuration is separate; see docs/how-to/aismr-deployment.md.
