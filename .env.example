# Core (minimal essentials)
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./e2e_local.db
USE_LANGGRAPH_ENGINE=true
API_KEY=dev-api-key
LLAMA_STACK_URL=http://localhost:5001
LLAMA_STACK_MODEL=openai/gpt-5-nano
LLAMA_STACK_PROVIDER=fake
OPENAI_STANDARD_WEBHOOK_SECRET=
OPENAI_SORA_SIGNING_SECRET=
SORA_PROVIDER=fake
REMOTION_PROVIDER=fake
UPLOAD_POST_PROVIDER=fake
DISABLE_BACKGROUND_WORKFLOWS=true

# Providers (only if you use real services)
WEBHOOK_BASE_URL=http://localhost:8000
REMOTION_SERVICE_URL=http://localhost:3001
REMOTION_API_SECRET=
REMOTION_WEBHOOK_SECRET=devremotion
WEBHOOK_SECRET=devremotion
# Remotion sandbox configuration (SECURITY: defaults to enabled for safety)
# WARNING: Disabling sandbox or allowing composition code in production requires careful review.
# Sandbox provides isolation and prevents arbitrary code execution.
REMOTION_SANDBOX_ENABLED=true
REMOTION_ALLOW_COMPOSITION_CODE=false
REMOTION_SANDBOX_STRICT=false
# Remotion service hardening
REMOTION_OUTPUT_PUBLIC=false
REMOTION_CALLBACK_ALLOWLIST=
REMOTION_RENDER_TIMEOUT_SECONDS=900
REMOTION_CALLBACK_TIMEOUT_MS=5000
REMOTION_JOB_CONCURRENCY=1
REMOTION_FRAME_CONCURRENCY=1
# A whole number is valid for constrained local rendering, for example: 1
REMOTION_MEDIA_ALLOWED_ORIGINS=
REMOTION_MAX_MEDIA_BYTES=67108864
REMOTION_MAX_JOB_STAGED_BYTES=268435456
REMOTION_MEDIA_FETCH_TIMEOUT_MS=30000
REMOTION_PROBE_TIMEOUT_MS=15000
# Command names by default. Set absolute paths only when PATH does not resolve them.
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
REMOTION_BUNDLE_CACHE_MAX=32
REMOTION_BUNDLE_CACHE_TTL_SECONDS=3600
REMOTION_BROWSER_IDLE_TTL_SECONDS=300
# Note: Both flags must be true for custom TSX code (sandbox is mandatory for security)
# In production, review these settings carefully and ensure sandbox isolation is adequate.

# External keys (optional)
BRAVE_API_KEY=
SENTRY_DSN=

# Observability (debug only; payloads may contain sensitive data)
LOG_WEBHOOK_PAYLOADS=false

# Transcode / SSRF guard
TRANSCODE_MAX_CONCURRENCY=2
TRANSCODE_ALLOW_FILE_URLS=false
TRANSCODE_ALLOW_PRIVATE=false
TRANSCODE_ALLOWED_DOMAINS=[]

# Public demo UI (Firebase Hosting)
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_ALLOWED_WORKFLOWS=motivational
PUBLIC_DEMO_TOKEN_TTL_HOURS=72
PUBLIC_DEMO_RATE_LIMIT=10/minute
PUBLIC_DEMO_CORS_ORIGINS=https://aismr.mjames.dev

# Cost guards
MAX_RUNS_LAST_24H=1000
DAILY_COST_BUDGET_USD=200
ESTIMATED_COST_PER_RUN_USD=0.5

# Per-provider Sora debugging
# SORA_PROVIDER=real|fake|off
# SORA_FAKE_CLIPS_DIR=fake_clips/sora
# SORA_FAKE_CLIP_PATHS=/abs/path/to/clip1.mp4,/abs/path/to/clip2.mp4

# AISMR local fixture studio (nonsecret reference defaults)
# `python scripts/aismr_local.py` supplies its own loopback child-process values
# and does not rewrite this file. Leave live credentials out of this tracked example.
AISMR_ENABLED=false
AISMR_MODE=fixture
AISMR_LIVE_ENABLED=false
AISMR_PUBLIC_RUNTIME_ENABLED=false
AISMR_ADMISSION_PAUSED=false
AISMR_FIXTURE_MODERATION=allow
AISMR_ORIGIN=http://127.0.0.1:8311
AISMR_COOKIE_SECURE=false
# Optional lowercase suffix for separate studios on the same host.
# AISMR_SESSION_COOKIE_SUFFIX=live_trial
AISMR_SESSION_HOURS=24
AISMR_VISITOR_RUNS_24H=1
AISMR_IP_RUNS_24H=4
AISMR_ACTIVE_RUNS=2
# Private fixture demos only: removes admission quotas, not worker/render concurrency.
AISMR_FIXTURE_UNLIMITED_ADMISSIONS=false
AISMR_DAILY_BUDGET_USD=0
AISMR_RUN_RESERVATION_USD=0
# Live admission needs all seven owner-supplied positive amounts and a version.
# Keep this example disabled until the owner has verified current costs and rights.
# AISMR_COST_PROFILE_VERSION=owner-verified-version
# AISMR_COST_INPUT_MODERATION_USD=OWNER_SUPPLIED_POSITIVE_AMOUNT
# AISMR_COST_IDEATION_USD=OWNER_SUPPLIED_POSITIVE_AMOUNT
# AISMR_COST_PLAN_MODERATION_USD=OWNER_SUPPLIED_POSITIVE_AMOUNT
# AISMR_COST_VIDEO_REQUEST_USD=OWNER_SUPPLIED_POSITIVE_AMOUNT
# AISMR_COST_NARRATION_BATCH_USD=OWNER_SUPPLIED_POSITIVE_AMOUNT
# AISMR_COST_RENDER_USD=OWNER_SUPPLIED_POSITIVE_AMOUNT
# AISMR_COST_FINAL_MODERATION_USD=OWNER_SUPPLIED_POSITIVE_AMOUNT
AISMR_ASSET_RETRIES=1
AISMR_PLAN_REVISIONS=1
# Live defaults to single-v1. creative-v2 reserves up to six calls per version.
# AISMR_PLANNER_VERSION=creative-v2
# New creative plans pin these separately; the Codex call cap remains 90 seconds.
AISMR_IDEATION_DEADLINE_SECONDS=120
AISMR_CREATIVE_WORKFLOW_DEADLINE_SECONDS=660
# Opt new creative plans into at most two validation-only text repairs.
AISMR_CREATIVE_REPAIR_ATTEMPTS=0
AISMR_POLL_SECONDS=3
AISMR_JOB_CONCURRENCY=2
AISMR_RUN_DEADLINE_HOURS=24
AISMR_RETENTION_DAYS=7
# Private loopback or explicitly enabled Tailscale Serve live evaluations.
# Rejected for public runtimes. Does not extend approval deadlines.
AISMR_PRESERVE_RUN_ARTIFACTS=false
# Private Tailscale Serve only, never Funnel. Requires HTTPS + secure cookies.
AISMR_PRIVATE_TAILNET_ENABLED=false
AISMR_MEDIA_ROOT=.local/aismr/media
AISMR_FIXTURE_ROOT=.local/aismr/fixtures
# AISMR_RECORDED_ROOT=/absolute/path/to/approved-recorded-archive
# Public-library state must remain separate from every source-mode database and media root.
# AISMR_LIBRARY_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/aismr-library.sqlite3
# AISMR_LIBRARY_MEDIA_ROOT=/absolute/path/to/aismr-library-media
# AISMR_RIGHTS_PROFILE_PATH=/absolute/path/to/owner-verified-public-rights.json
AISMR_MEDIA_ALLOWED_ORIGINS=["https://fal.media","https://v3.fal.media"]
AISMR_MAX_ASSET_BYTES=67108864
AISMR_MAX_RUN_BYTES=268435456
AISMR_RENDER_REAL=false
AISMR_MUSIC_ID=

# Native TikTok owner test: supply these through the 1Password FIFO, not this file.
# See docs/reference/tiktok-native-local.md. The visitor launcher is unchanged.
# AISMR_TIKTOK_CLIENT_KEY=
# AISMR_TIKTOK_CLIENT_SECRET=
